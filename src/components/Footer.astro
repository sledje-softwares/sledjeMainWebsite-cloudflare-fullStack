---
import favicon from '../assets/brand/favicon-full-j-oxblood.svg';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-row">
    <img src={favicon.src} width="28" height="28" alt="Sledje" class="mark" />
    <SocialIcons />
  </div>
  <p class="footer-copy">
    &copy; {year} Sledje Softwares. Built for Indian legal professionals.
  </p>
  <a class="footer-email" href="mailto:info@sledje.com">info@sledje.com</a>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-md);
    background: var(--color-secondary);
    color: var(--color-secondary-contrast);
  }

  .footer-row {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .mark {
    border-radius: var(--radius-sm);
  }

  .footer-copy {
    margin: 0;
    color: color-mix(in srgb, var(--color-secondary-contrast) 65%, transparent);
    font-size: var(--font-size-caption);
    text-align: center;
  }

  .footer-email {
    color: color-mix(in srgb, var(--color-secondary-contrast) 65%, transparent);
    font-size: var(--font-size-caption);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-email:hover,
  .footer-email:focus-visible {
    color: var(--color-secondary-contrast);
  }
</style>
