---
import TagBadge from './TagBadge.astro';
---

<section class="hero">
  <TagBadge label="Coming soon" />

  <h1 class="hero-headline" data-reveal>
    Something built for your chambers is on its way.
  </h1>

  <p class="hero-subtext" data-reveal>
    Litigation management for Indian advocates — matters, hearings, and
    client updates, kept in one place instead of three.
  </p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero-headline {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--font-size-display-sm);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text);
  }

  .hero-subtext {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-2xl) var(--space-3xl);
    }

    .hero-headline {
      font-size: var(--font-size-display-lg);
    }
  }
</style>
