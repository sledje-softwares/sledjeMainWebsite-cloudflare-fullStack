---
/**
 * Renders one icon link per non-empty entry in `socials.config.ts`.
 * Icons are minimal inline SVGs (no icon-library dependency) that
 * inherit color via currentColor, so they follow the surrounding
 * text color in both themes automatically.
 */
import { socials, socialLabels, type SocialKey } from '../config/socials.config';

const order: SocialKey[] = ['linkedin', 'twitter', 'instagram', 'youtube', 'whatsappCommunity'];
const active = order.filter((key) => socials[key]);
---

{
  active.length > 0 && (
    <ul class="social-icons">
      {active.map((key) => (
        <li>
          <a href={socials[key]} target="_blank" rel="noopener noreferrer" aria-label={socialLabels[key]}>
            {key === 'linkedin' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.64h.05c.53-.98 1.83-2 3.77-2 4.03 0 4.78 2.55 4.78 5.87V21H18v-5.6c0-1.34-.02-3.06-1.94-3.06-1.94 0-2.24 1.44-2.24 2.96V21H10V9Z" />
              </svg>
            )}
            {key === 'twitter' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M18.9 3H21l-6.66 7.61L22.2 21h-6.2l-4.86-6.4L5.6 21H3.5l7.12-8.14L2.8 3h6.35l4.4 5.86L18.9 3Zm-1.08 16.17h1.17L7.24 4.75H5.98l11.84 14.42Z" />
              </svg>
            )}
            {key === 'instagram' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            )}
            {key === 'youtube' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M22 12s0-3.2-.4-4.7a3 3 0 0 0-2.1-2.1C17.9 4.75 12 4.75 12 4.75s-5.9 0-7.5.45A3 3 0 0 0 2.4 7.3C2 8.8 2 12 2 12s0 3.2.4 4.7a3 3 0 0 0 2.1 2.1c1.6.45 7.5.45 7.5.45s5.9 0 7.5-.45a3 3 0 0 0 2.1-2.1c.4-1.5.4-4.7.4-4.7Zm-11.9 3.1V8.9L15.5 12l-5.4 3.1Z" />
              </svg>
            )}
            {key === 'whatsappCommunity' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 2.75A9.2 9.2 0 0 0 3.9 16.7L2.75 21l4.42-1.13A9.2 9.2 0 1 0 12 2.75Zm0 1.6a7.6 7.6 0 1 1-4.05 14.03l-.28-.17-2.6.67.7-2.54-.19-.29A7.6 7.6 0 0 1 12 4.35Zm-3.1 3.5c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.35 1 2.51c.12.16 1.7 2.7 4.2 3.7 2.08.82 2.5.66 2.95.62.45-.05 1.45-.6 1.65-1.17.2-.58.2-1.08.14-1.18-.06-.1-.22-.16-.46-.28-.24-.12-1.45-.72-1.68-.8-.22-.08-.38-.12-.55.12-.16.24-.63.8-.77.96-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.36-.76-1.86-.2-.48-.4-.42-.55-.43Z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social-icons {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-lg);
    height: var(--space-lg);
    border-radius: var(--radius-full);
    color: var(--color-secondary-contrast);
    opacity: 0.75;
    transition: opacity var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .social-icons a:hover,
  .social-icons a:focus-visible {
    opacity: 1;
    background-color: rgb(255 255 255 / 0.08);
  }
</style>
