---
/**
 * The page's one deliberate flourish: the "Coming soon" announcement
 * itself, set 1.6x the headline's size — one step up the modular
 * scale — with a single soft glint of light sweeping across it every
 * --duration-sweep — like light catching ink on a page, not a
 * decorative gradient bolted onto the hero — see README "Motion".
 *
 * Single text layer, one gradient: the non-highlight portion of the
 * gradient is flat --color-primary, so at rest the glyphs render
 * pixel-identical to plain colored text — no second copy of the text
 * stacked on top to go out of alignment and read as blur.
 */
interface Props {
  label?: string;
}

const { label = 'Coming soon' } = Astro.props;
---

<p class="coming-soon" data-reveal>{label}</p>

<style>
  .coming-soon {
    font-family: var(--font-display);
    font-size: var(--font-size-display-lg);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-primary);
  }

  /* The sweep only replaces the flat fill when the browser can clip a
     background to text; unsupported browsers keep the plain solid
     color above rather than risking invisible (transparent) text. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .coming-soon {
      color: transparent;
      background-image: linear-gradient(
        100deg,
        var(--color-primary) 47%,
        var(--color-sweep-highlight) 50%,
        var(--color-primary) 53%
      );
      background-size: 300% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      animation: sweep var(--duration-sweep) linear infinite;
    }
  }

  /* One pass of light, then a rest for the remainder of the interval. */
  @keyframes sweep {
    0% {
      background-position: 100% 0;
    }
    15% {
      background-position: -100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coming-soon {
      animation: none;
      background-position: 0 0;
    }
  }

  @media (min-width: 48rem) {
    .coming-soon {
      font-size: var(--font-size-display-xl);
    }
  }
</style>
