---
import favicon from '../assets/brand/favicon-full-j-oxblood.svg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sledje — Coming soon',
  description = 'Litigation management for Indian advocates and law firms — matters, hearings, and client communication in one place. Coming soon.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fdfdfd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#171412" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		<noscript>
			<style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style>
		</noscript>
		<script>
			import { initReveal } from '../scripts/reveal';
			initReveal();
		</script>
	</body>
</html>
